# CareMatrix backend environment variables
# Copy this file to .env and fill in real values. Never commit the real .env.

PORT=5000

# MongoDB connection string (local or Atlas)
MONGO_URI=

# Secret used to sign JWTs - use a long random string in real deployments
JWT_SECRET=replace_this_with_a_long_random_string

# How long issued JWTs remain valid
JWT_EXPIRES_IN=7d

# Password used ONLY by seed/seedData.js to create demo accounts (dev only)
SEED_DEMO_PASSWORD=
